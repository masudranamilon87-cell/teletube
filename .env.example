# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Public HTTPS URL of deployed mini app (required for channel posts)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Channel / group where bot posts videos (@channel or -100...)
TELEGRAM_POST_CHAT_ID=@YourChannelUsername

# Optional: t.me startapp links in captions
TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_MINI_APP_SHORT_NAME=app

# Comma-separated Telegram user IDs with admin access (optional)
ADMIN_TELEGRAM_IDS=123456789

# Web admin login (profile → admin panel)
ADMIN_USERNAME=Masudadmin
ADMIN_PASSWORD=your_secure_admin_password

# JWT secret (defaults to TELEGRAM_BOT_TOKEN if unset)
JWT_SECRET=change_me_in_production

# SQLite file (use this on Railway — do NOT add Postgres plugin)
SQLITE_DATABASE_PATH=./data/teletube.sqlite
# Legacy alias (ignored if Railway injects postgres://…)
DATABASE_URL=./data/teletube.sqlite

# Token economy
WELCOME_BONUS_TOKENS=50
REWARDED_AD_TOKENS=5
REWARDED_DAILY_LIMIT=10
REWARDED_SESSION_MAX_AGE_MIN=60
NEXT_PUBLIC_REWARDED_AD_LOAD_TIMEOUT_MS=25000
# Popup: first show after N seconds, then every N minutes while app is open
NEXT_PUBLIC_POPUP_AD_FIRST_DELAY_SEC=8
NEXT_PUBLIC_POPUP_AD_INTERVAL_MIN=5
# Social bar: first show after N sec, then every N minutes (return to app = cycle restarts)
NEXT_PUBLIC_SOCIAL_BAR_DELAY_SEC=20
NEXT_PUBLIC_SOCIAL_BAR_INTERVAL_MIN=10
NEXT_PUBLIC_SMART_LINK_DELAY_SEC=30
NEXT_PUBLIC_SMART_LINK_INTERVAL_MIN=5
MIDROLL_INTERVAL_MIN=5
INIT_DATA_MAX_AGE_SEC=86400

# WhatsApp OTP for registration (dev: logs code to server console)
WHATSAPP_OTP_DEV=true
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_OTP_MESSAGE=Your TeleTube code is {code}
